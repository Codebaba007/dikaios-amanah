# Dikaios Amanah — backend environment template
# Copy to backend/.env and fill in real values. Never commit the real file.

# --- Database -------------------------------------------------------------
# Local Docker:  postgresql://admin:password@localhost:5433/dikaios_amanah?schema=public
# Neon (pooled): postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://admin:password@localhost:5433/dikaios_amanah?schema=public"

# Direct (non-pooled) connection, used only by `prisma migrate deploy`.
# Leave empty locally; Neon provides a second hostname without "-pooler".
DIRECT_URL=""

# --- Server ---------------------------------------------------------------
PORT=5000
NODE_ENV=development

# --- Auth -----------------------------------------------------------------
# Generate a long random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# It must be identical for every backend instance, otherwise tokens are rejected.
JWT_SECRET="replace-with-a-long-random-secret"

# --- CORS -----------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
FRONTEND_URL="http://localhost:5173"

# --- Upload storage -------------------------------------------------------
# local = disk (fine locally / with a persistent disk)
# s3    = S3-compatible bucket (required on hosts with an ephemeral filesystem)
STORAGE_DRIVER=local

# Only needed when STORAGE_DRIVER=s3 (Cloudflare R2 / Supabase Storage / S3 / B2).
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=dikaios-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
